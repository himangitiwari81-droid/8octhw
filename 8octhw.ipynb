     "text": [
      "6 is not a prime number.\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter a number: \"))\n",
    "for i in range (2, num):\n",
    "    if num % i == 0:\n",
    "        print(f\"{num} is not a prime number.\")\n",
    "        break\n",
    "else:\n",
    "    print(\"prime\")"
   ]
